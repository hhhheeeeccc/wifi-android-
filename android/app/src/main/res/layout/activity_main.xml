<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A237E"
        app:title="@string/app_name"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A237E"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_inactive"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/ssidInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ssid_hint"
                    android:text="MyWiFiHotspot"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    android:text="12345678"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/scanConnectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/scan_to_connect"
                    android:backgroundTint="#007BFF"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/toggleVpnBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/enable_vpn_tunnel"
                    android:backgroundTint="#673AB7"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/toggleHotspot"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/enable_hotspot"
                    android:backgroundTint="#28A745"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/proxyBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/local_only_mode"
                    style="?android:attr/borderlessButtonStyle" />

                <LinearLayout
                    android:id="@+id/proxyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F0F4FF"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_info"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:id="@+id/proxy_host_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_host"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/proxy_port_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_port" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/proxy_instruction"
                        android:text="@string/proxy_instruction"
                        android:textSize="11sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />

                    <ImageView
                        android:id="@+id/qrCodeImage"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/white"
                        android:padding="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connected_devices"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/devicesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:divider="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
